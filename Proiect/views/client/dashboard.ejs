<!DOCTYPE html>
<html lang="ro" data-tema="<%= tema %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Portal Client — Vila Bradu</title>
  <link rel="stylesheet" href="/css/style.css">
  <script>
    window.currentUserNume = "<%= user.nume %>";
    window.currentUserRole = "<%= user.role %>";
    window.currentUserId = "<%= user.username %>";
  </script>
</head>
<body>

<nav class="nav">
  <a href="/" class="nav-brand">Vila <span>Bradu</span></a>
  <ul class="nav-links">
    <li><a href="/client">Portalul Meu</a></li>
    <li><a href="/logout">Deconectare</a></li>
    <li class="tema-toggle">
      <form action="/pensiune/tema" method="POST">
        <input type="hidden" name="tema" value="<%= tema === 'dark' ? 'light' : 'dark' %>">
        <button type="submit" class="tema-btn">
          <%= tema === 'dark' ? '☀ Luminos' : '☾ Întunecat' %>
        </button>
      </form>
    </li>
  </ul>
</nav>

<!-- Session bar -->
<div class="session-bar">
  <div>
    <span class="dot"></span>
    Conectat ca Client: <strong><%= user.nume %></strong>
  </div>
  <div>
    Vizite portal: <strong><%= views %></strong>
    &nbsp;·&nbsp;
    <% if (tema === 'dark') { %>
      🌙 Temă întunecată activă
    <% } else { %>
      ☀ Temă luminoasă activă
    <% } %>
  </div>
</div>

<div class="page">
  <div class="sidebar-layout">

    <!-- Sidebar -->
    <aside class="sidebar">
      <div class="sidebar-label">Navigare</div>
      <nav>
        <a href="/client" class="active">📋 Rezervările Mele</a>
      </nav>
      
      <!-- Widget cookies: Rezervari vizualizate recent -->
      <div class="recent-widget">
        <div class="sidebar-label">Vizualizate recent</div>
        <ul class="recent-list" id="recent-bookings-list">
          <li class="recent-item" style="color:var(--text-light);padding:0.5rem;font-size:0.75rem;">Se încarcă...</li>
        </ul>
      </div>

      <div class="sidebar-label">Cont</div>
      <nav>
        <a href="/logout">← Deconectare</a>
      </nav>
    </aside>

    <!-- Main content -->
    <main>
      <span class="section-subtitle">Portalul tău de client</span>
      <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap: 1rem; margin-bottom: 1rem;">
        <h1 class="section-title" style="margin:0;">Salutare, <%= user.nume.split(' ')[0] %>!</h1>
        <button class="btn btn-primary" id="btn-open-modal" style="padding:0.5rem 1.25rem; font-size:0.78rem;">+ Rezervare Nouă</button>
      </div>
      <hr class="divider">

      <!-- Lista rezervari client -->
      <div class="table-wrap" style="margin-bottom: 3rem;">
        <div class="table-header">
          <h2>Rezervările mele</h2>
          <span style="font-size:0.78rem;color:var(--text-light)">
            <%= rezervari.length %> înregistrări
          </span>
        </div>
        <table>
          <thead>
            <tr>
              <th>Oaspete</th>
              <th>Camera</th>
              <th>Tip</th>
              <th>Check-in</th>
              <th>Check-out</th>
              <th>Nopți</th>
              <th>Preț Total</th>
              <th>Status</th>
              <th>Detalii</th>
            </tr>
          </thead>
          <tbody>
            <% if (rezervari.length === 0) { %>
              <tr>
                <td colspan="9" style="text-align: center; color: var(--text-light); padding: 2rem;">
                  Nu ai nicio rezervare activă. Apasă pe "+ Rezervare Nouă" pentru a rezerva o cameră!
                </td>
              </tr>
            <% } else { %>
              <% rezervari.reverse().forEach(function(r) { %>
                <tr data-id="<%= r.id %>">
                  <td><strong><%= r.numeOaspete %></strong></td>
                  <td><%= r.camera %></td>
                  <td><%= r.tipCamera %></td>
                  <td><%= r.checkIn %></td>
                  <td><%= r.checkOut %></td>
                  <td><%= r.nrNopti %></td>
                  <td><strong><%= (r.nrNopti * r.pretNoapte).toLocaleString('ro-RO') %> RON</strong></td>
                  <td>
                    <span class="badge badge-<%= r.status %>">
                      <%= r.status === 'in_asteptare' ? 'În așteptare' : r.status.charAt(0).toUpperCase() + r.status.slice(1) %>
                    </span>
                  </td>
                  <td>
                    <a href="/pensiune/rezervari/<%= r.id %>">Vezi →</a>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- Asistent Virtual Chatbot -->
      <div class="divider"></div>
      
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; align-items: start; margin-top:2rem;">
        <div>
          <h2 style="font-family: var(--font-display); font-size:1.6rem; color:var(--dark); margin-bottom:0.5rem;">Asistent Virtual Inteligent</h2>
          <p style="color:var(--text-light); font-size:0.88rem; line-height:1.6; margin-bottom: 1rem;">
            Discută direct cu asistentul nostru virtual pentru a afla tarifele camerelor, informații de contact sau pentru a verifica ce camere sunt libere la o anumită dată.
          </p>
          <div style="padding: 1rem; background: var(--warm-white); border: 1px solid var(--border); border-radius: var(--radius); font-size:0.8rem; line-height: 1.5; color: var(--text);">
            💬 <strong>Încearcă să scrii:</strong>
            <ul style="margin-left: 1.25rem; margin-top: 0.25rem; color: var(--text-light);">
              <li>"salut"</li>
              <li>"care sunt prețurile?"</li>
              <li>"contact pensiune"</li>
              <li>"camere libere pe 2024-06-15" (folosind formatul YYYY-MM-DD)</li>
            </ul>
            <div style="margin-top:0.75rem; border-top:1px dashed var(--border); padding-top:0.5rem; font-size:0.75rem; font-style:italic; color:var(--text-light);">
              Notă: Dacă asistentul nu cunoaște răspunsul la o întrebare specifică, discuția va fi preluată automat de un operator din recepție!
            </div>
          </div>
        </div>

        <!-- Chat Widget -->
        <div class="chat-widget" id="chat-widget-box">
          <div class="chat-header">
            <span>Asistent Virtual Vila Bradu</span>
            <span class="chat-status"><span class="pulse-dot"></span> Online</span>
          </div>
          <div class="chat-messages" id="chat-messages-container">
            <div class="chat-msg system">
              <div class="chat-msg-bubble">🤖 Asistentul este pregătit. Scrie un mesaj mai jos pentru a începe.</div>
            </div>
          </div>
          <div class="chat-input-area">
            <input type="text" id="chat-msg-input" placeholder="Întreabă asistentul sau scrie staff-ului...">
            <button id="chat-msg-send">Trimite</button>
          </div>
        </div>
      </div>

    </main>
  </div>
</div>

<!-- Modal adaugare rezervare AJAX -->
<div class="modal" id="add-booking-modal">
  <div class="modal-content">
    <div class="modal-header">
      <h2>Adăugare Rezervare Nouă</h2>
      <button class="modal-close" id="btn-close-modal">&times;</button>
    </div>
    <form id="add-booking-form">
      <div class="modal-body">
        <div class="form-group">
          <!-- Autopopulam cu numele clientului logat, dar lasam campul editabil in caz ca rezerva pt altcineva -->
          <label for="numeOaspete">Nume Oaspete</label>
          <input type="text" id="numeOaspete" name="numeOaspete" required value="<%= user.nume %>">
        </div>
        
        <div class="form-group" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
          <div>
            <label for="camera">Camera</label>
            <select name="camera" id="camera" style="width: 100%; padding: 0.7rem 1rem; border: 1px solid var(--border); background: var(--cream); border-radius: var(--radius); outline: none; font-family: var(--font-body); font-size: 0.9rem; color: var(--dark);">
              <option value="101">Camera 101 (Single, 150 RON)</option>
              <option value="102">Camera 102 (Single, 150 RON)</option>
              <option value="104">Camera 104 (Double, 220 RON)</option>
              <option value="201">Camera 201 (Single, 150 RON)</option>
              <option value="205">Camera 205 (Double, 220 RON)</option>
              <option value="302">Camera 302 (Suite, 380 RON)</option>
              <option value="303">Camera 303 (Suite, 380 RON)</option>
            </select>
          </div>
          <div>
            <label for="telefon">Telefon de contact</label>
            <input type="text" id="telefon" name="telefon" placeholder="ex: 0722 111 222">
          </div>
        </div>

        <div class="form-group" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
          <div>
            <label for="checkIn">Dată Check-in</label>
            <input type="date" id="checkIn" name="checkIn" required value="2026-06-10">
          </div>
          <div>
            <label for="checkOut">Dată Check-out</label>
            <input type="date" id="checkOut" name="checkOut" required value="2026-06-13">
          </div>
        </div>

        <div class="form-group" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
          <div>
            <label for="nrNopti">Număr nopți</label>
            <input type="number" id="nrNopti" name="nrNopti" min="1" value="3" required>
          </div>
          <div>
            <input type="hidden" name="status" value="in_asteptare">
          </div>
        </div>

        <div class="form-group">
          <label for="observatii">Observații speciale</label>
          <input type="text" id="observatii" name="observatii" placeholder="ex: pat suplimentar, mic dejun inclus">
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" id="btn-cancel-modal">Renunță</button>
        <button type="submit" class="btn btn-primary" id="btn-submit-booking">Trimite Cerere Rezervare</button>
      </div>
    </form>
  </div>
</div>

<!-- Widget consimtamant cookies -->
<%- include('../partials/cookie-banner') %>

<!-- Client JavaScript -->
<script src="/js/app-client.js"></script>
</body>
</html>
