<!DOCTYPE html>
<html>
<head><title>Editare <%= device.name %></title></head>
<body style="font-family: Arial, sans-serif; margin: 40px;">

    <h1>Editare: <%= device.name %></h1>

    <% if (error) { %>
        <div style="color: red; border: 1px solid red; padding: 10px; margin-bottom: 15px; width: 300px;">
            **Eroare:** <%= error %>
        </div>
    <% } %>

    <form action="/devices/<%= device._id %>/edit" method="POST">
        <label>Nume Dispozitiv:</label><br>
        <input type="text" name="name" value="<%= device.name %>" required><br><br>

        <label>Preț (RON):</label><br>
        <input type="number" name="price" value="<%= device.price %>" required><br><br>

        <label>Categorie:</label><br>
        <select name="category">
            <option value="Senzor" <%= device.category === 'Senzor' ? 'selected' : '' %>>Senzor</option>
            <option value="Actuator" <%= device.category === 'Actuator' ? 'selected' : '' %>>Actuator</option>
            <option value="Controler" <%= device.category === 'Controler' ? 'selected' : '' %>>Controler</option>
            <option value="Retea" <%= device.category === 'Retea' ? 'selected' : '' %>>Rețea</option>
        </select><br><br>

        <label>Status Conexiune:</label><br>
        <select name="isOnline">
            <option value="true" <%= device.isOnline ? 'selected' : '' %>>Online</option>
            <option value="false" <%= !device.isOnline ? 'selected' : '' %>>Offline</option>
        </select><br><br>

        <button type="submit" style="background: blue; color: white; padding: 8px 15px; border: none; cursor: pointer;">Actualizează</button>
    </form>

    <br>
    <a href="/devices/<%= device._id %>">Anulează</a>

</body>
</html>